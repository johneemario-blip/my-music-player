{
  "name": "my-music-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prebuild": "expo prebuild --clean",
    "e2e:build:ios": "detox build -c ios.sim.release",
    "e2e:test:ios": "detox test -c ios.sim.release",
    "e2e:build:ios:debug": "detox build -c ios.sim.debug",
    "e2e:test:ios:debug": "detox test -c ios.sim.debug",
    "e2e:build:android": "detox build -c android.emu.release",
    "e2e:test:android": "detox test -c android.emu.release",
    "e2e:build:android:debug": "detox build -c android.emu.debug",
    "e2e:test:android:debug": "detox test -c android.emu.debug"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "detox": "^20.51.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
